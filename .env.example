# ==============================================================
# DRIVIO - Mobility Marketplace Environment Configuration
# ==============================================================

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/drivio
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_PROFILES_ACTIVE=postgres

# Server & Networking
PORT=8080
FRONTEND_PORT=5173

# JWT Security
DRIVIO_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
DRIVIO_JWT_EXPIRATION_MS=86400000
DRIVIO_JWT_REFRESH_EXPIRATION_MS=604800000

# AI Configuration (Llama 3.1 8B via Ollama)
DRIVIO_AI_OLLAMA_URL=http://localhost:11434
DRIVIO_AI_OLLAMA_MODEL=llama3.1:8b
DRIVIO_AI_ENABLED=true

# File Storage for KYC Documents
DRIVIO_STORAGE_UPLOAD_DIR=./uploads/documents

# OSRM Routing Engine (Optional - defaults to OpenStreetMap OSRM)
DRIVIO_ROUTING_OSRM_URL=https://router.project-osrm.org

